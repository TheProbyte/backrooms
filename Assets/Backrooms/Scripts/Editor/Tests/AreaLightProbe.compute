#pragma kernel FormFactor
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Assets/Backrooms/Shaders/BackroomsAreaLight.hlsl"

// Form factor of a horizontal rectangle, per query: xyz position, then xyz normal; centre and half sizes are shared.
StructuredBuffer<float3> _Positions;
StructuredBuffer<float3> _Normals;
RWStructuredBuffer<float> _Results;
float4 _Rect;   // xyz centre, w unused
float4 _Half;   // xy half sizes
int _Count;

[numthreads(64, 1, 1)]
void FormFactor(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Count) return;
    _Results[id.x] = BR_RectFormFactor(_Positions[id.x], normalize(_Normals[id.x]), _Rect.xyz, _Half.xy);
}
