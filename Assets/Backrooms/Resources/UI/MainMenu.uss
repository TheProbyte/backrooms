/* Main menu, settings and YOUR LOOK: the company's own paperwork (Docs/StyleSheet.md). A chocolate panel with the amber
   frame, cream type in Courier Prime (UiKit), the item under the cursor on the company amber, the orange, gold and
   avocado stripe under the title. Colours are the kit's names (Kit.uss); the smallest text is the kit's floor, 17 px.
   (2026-11-10: the Classic look's navy and white rules are gone; this was .mm-ov.) */

.mm-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.mm-root .unity-label, .mm-root .unity-text-element {
    color: var(--cream); letter-spacing: 1px; margin: 0; padding: 0;
    text-shadow: 2px 2px 0 var(--shadow);
}

.mm-panel {
    position: absolute; left: 8%; top: 25%; width: 430px;
    background-color: var(--panel);
    border-width: 2px; border-color: var(--amber); border-radius: 6px;
    padding: 12px 14px 12px 14px;
}
.mm-panel.mm-wide { width: 640px; top: 19%; }

.mm-header { flex-direction: row; align-items: flex-end; margin: 0 2px 6px 2px; }
.mm-root .mm-title { font-size: 30px; -unity-font-style: bold; letter-spacing: 4px; }
.mm-root .mm-page { font-size: 17px; margin-left: 16px; margin-bottom: 5px; flex-grow: 1; color: var(--tan); letter-spacing: 2px; }
.mm-rule { height: 2px; background-color: var(--amber); margin: 2px 0 10px 0; }

.mm-list { flex-direction: column; }

/* A menu item: the arrow column and the words. */
.mm-item { flex-direction: row; align-items: center; padding: 6px 10px 6px 4px; margin: 2px 0; border-radius: 4px; }
.mm-root .mm-cursor { width: 34px; font-size: 26px; -unity-text-align: middle-center; opacity: 0; }
.mm-root .mm-text { font-size: 30px; letter-spacing: 5px; -unity-font-style: bold; }
.mm-item.mm-sel { background-color: var(--amber); }
.mm-root .mm-item.mm-sel .unity-label { color: var(--choc); text-shadow: 0 0 0 var(--none); }
.mm-root .mm-item.mm-sel .mm-cursor { opacity: 1; }
.mm-item.mm-small .mm-text { font-size: 22px; letter-spacing: 4px; }

/* A save slot: its name and what is on it, and an ERASE tag on the right. */
.mm-slot { align-items: flex-start; padding: 10px 10px 10px 4px; margin: 4px 0; border-width: 1px; border-color: var(--line); border-radius: 4px; }
.mm-slot.mm-sel { border-color: var(--amber); }
.mm-slot .mm-cursor { margin-top: 2px; }
.mm-slotbody { flex-grow: 1; flex-direction: column; }
.mm-root .mm-slotname { font-size: 26px; letter-spacing: 4px; -unity-font-style: bold; }
.mm-root .mm-detail { font-size: 17px; letter-spacing: 1px; margin-top: 4px; color: var(--tan); }
.mm-root .mm-empty { font-size: 18px; letter-spacing: 2px; margin-top: 6px; color: var(--gold); }
.mm-root .mm-erase {
    font-size: 17px; letter-spacing: 2px; padding: 4px 10px; margin-top: 2px;
    border-width: 1px; border-color: var(--line-strong); border-radius: 3px; -unity-text-align: middle-center;
}
.mm-root .mm-erase:hover { background-color: var(--cream); color: var(--choc); text-shadow: 0 0 0 var(--none); }
.mm-root .mm-erase.mm-armed { background-color: var(--bad); border-color: var(--cream); color: var(--cream); }
.mm-root .mm-slot.mm-sel .mm-erase { border-color: var(--choc-soft); }
.mm-root .mm-item.mm-sel .mm-detail, .mm-root .mm-item.mm-sel .mm-empty { color: var(--choc); }

.mm-root .mm-note { font-size: 20px; letter-spacing: 2px; margin: 8px 4px 6px 4px; }
.mm-root .mm-desc { font-size: 17px; color: var(--tan); margin: 0 4px 14px 4px; white-space: normal; letter-spacing: 0; }

.mm-root .mm-hint { font-size: 17px; color: var(--tan); margin: 10px 2px 0 2px; letter-spacing: 1px; }

/* Co-op (2026-11-05): a row with a text field (your name, the host's address, the port). */
.mm-fieldrow { padding: 4px 10px 4px 4px; }
.mm-root .mm-fieldlabel { font-size: 22px; letter-spacing: 4px; -unity-font-style: bold; width: 150px; }
.mm-field { flex-grow: 1; margin: 0; }
.mm-field .unity-base-text-field__input, .mm-field .unity-text-field__input {
    background-color: var(--field); border-width: 1px; border-color: var(--line-strong); border-radius: 3px;
    font-size: 22px; padding: 4px 8px; color: var(--cream); -unity-font-style: bold;
}
.mm-root .mm-field .unity-text-element { color: var(--cream); }
.mm-item.mm-sel .mm-field .unity-base-text-field__input { border-color: var(--choc); }
.mm-root .mm-panel.mm-wide .mm-note { white-space: normal; }

/* The company stripe under the title. */
.mm-stripe { display: flex; flex-direction: row; height: 6px; margin: -6px 0 10px 0; }
.mm-s1, .mm-s2, .mm-s3 { flex-grow: 1; }
.mm-s1 { background-color: var(--orange); }
.mm-s2 { background-color: var(--gold); }
.mm-s3 { background-color: var(--avocado); }

/* YOUR LOOK (Menu/LookMenu.cs): the choices beside an ID card with the live picture of your suited head. */
.mm-panel.lk-panel { width: 940px; top: 12%; }
.lk-body { flex-direction: row; align-items: flex-start; }
.lk-list { flex-grow: 1; margin-right: 18px; }
.lk-option { padding: 3px 10px 3px 4px; margin: 1px 0; }
.mm-root .lk-label { font-size: 20px; letter-spacing: 3px; -unity-font-style: bold; width: 210px; }
.mm-root .lk-value { font-size: 20px; letter-spacing: 2px; -unity-font-style: bold; flex-grow: 1; }
.lk-option .mm-field .unity-base-text-field__input, .lk-option .mm-field .unity-text-field__input { font-size: 18px; padding: 2px 8px; }
.lk-card {
    width: 300px; padding: 10px; flex-shrink: 0;
    background-color: var(--cream); border-width: 2px; border-color: var(--amber); border-radius: 8px;
}
.lk-preview { width: 280px; height: 350px; border-width: 1px; border-color: var(--choc-soft); }
.mm-root .lk-cardtext { font-size: 18px; letter-spacing: 2px; margin-top: 8px; -unity-font-style: bold; white-space: normal; color: var(--choc); text-shadow: 0 0 0 var(--none); }

/* ---- Settings (2026-11-10, Docs/UiPlan.md U10): tabs along the top, label and value in two columns, a bar under an
   amount, the chosen line's description in one place. ---- */
.mm-panel.st-panel { width: 820px; top: 12%; }
.st-tabs { flex-direction: row; flex-wrap: wrap; margin: 0 0 10px 0; }
.mm-root .st-tab {
    font-size: 17px; letter-spacing: 2px; -unity-font-style: bold; color: var(--tan);
    padding: 4px 10px 6px 10px; margin: 0 4px 4px 0; border-bottom-width: 3px; border-color: var(--none);
}
.mm-root .st-tab:hover { color: var(--cream); }
.mm-root .st-tab.st-on { color: var(--amber); border-bottom-color: var(--amber); }
.st-list { min-height: 300px; }
.st-row { align-items: flex-start; }
.mm-root .st-label { font-size: 22px; letter-spacing: 3px; -unity-font-style: bold; width: 330px; padding-top: 2px; }
.st-value { flex-grow: 1; flex-direction: column; }
.st-valrow { flex-direction: row; align-items: center; }
.mm-root .st-arrow { font-size: 18px; width: 30px; -unity-text-align: middle-center; color: var(--tan); }
.mm-root .st-arrow:hover { color: var(--cream); }
.mm-root .st-val { font-size: 22px; letter-spacing: 2px; -unity-font-style: bold; min-width: 200px; -unity-text-align: middle-center; }
.st-bar { height: 6px; margin: 4px 30px 2px 30px; background-color: var(--line); border-radius: 3px; }
.st-fill { height: 6px; background-color: var(--amber); border-radius: 3px; width: 0; }
.mm-item.mm-sel .st-bar { background-color: var(--choc-soft); }
.mm-item.mm-sel .st-fill { background-color: var(--choc); }
.mm-root .mm-item.mm-sel .st-arrow { color: var(--choc); }
.mm-root .st-desc {
    font-size: 17px; color: var(--tan); white-space: normal; min-height: 52px; margin: 10px 4px 0 4px;
    padding-top: 8px; border-top-width: 1px; border-color: var(--line);
}
.st-keyrow { flex-direction: row; align-items: center; margin: 3px 4px; }
.mm-root .st-key {
    font-size: 17px; -unity-font-style: bold; min-width: 130px; -unity-text-align: middle-center; padding: 2px 8px;
    border-width: 2px; border-bottom-width: 3px; border-color: var(--cream); border-radius: 5px; margin-right: 18px;
}
.mm-root .st-keywhat { font-size: 18px; }

/* ---- The title screen (2026-11-10, U8): the game's name over the picture, the menu under it, the build in a corner. ---- */
.tt-block { position: absolute; top: 20%; flex-direction: column; }
.mm-root .tt-name { font-size: 132px; -unity-font-style: bold; color: var(--amber); letter-spacing: 4px; text-shadow: 6px 6px 0 var(--shadow); }
.tt-stripe { flex-direction: row; height: 12px; width: 560px; margin: 2px 0 10px 6px; }
.tt-stripe > VisualElement { flex-grow: 1; }
.mm-root .tt-tag { font-size: 22px; letter-spacing: 6px; margin-left: 8px; }
.mm-panel.tt-menu { top: 52%; width: 520px; }
.mm-root .tt-build { position: absolute; right: 2%; bottom: 3%; font-size: 17px; color: var(--tan); }

/* ---- Save slots as cards (U11): the world's day, money, stage, time played and last played. ---- */
.sl-top { flex-direction: row; justify-content: space-between; align-items: flex-end; }
.mm-root .sl-day { font-size: 17px; -unity-font-style: bold; color: var(--gold); margin-right: 18px; }
.mm-root .mm-item.mm-sel .sl-day { color: var(--choc); }
.sl-facts { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
.mm-root .sl-fact { font-size: 17px; margin-right: 18px; color: var(--cream); }
.mm-root .mm-item.mm-sel .sl-fact { color: var(--choc); }

/* ---- The pause menu (U9): the main menu's panel, titled PAUSED; co-op lines and COPY. ---- */
.mm-panel.ps-panel { top: 22%; width: 560px; }
.ps-addr { flex-direction: row; align-items: center; justify-content: space-between; margin: 2px 4px; }
.mm-root .ps-addrtext { font-size: 17px; color: var(--tan); }
.mm-root .ps-copy {
    font-size: 17px; letter-spacing: 2px; padding: 2px 10px; border-width: 1px; border-color: var(--line-strong); border-radius: 3px;
}
.mm-root .ps-copy:hover { background-color: var(--cream); color: var(--choc); text-shadow: 0 0 0 var(--none); }

/* The KEYS page in two columns (it ran off the bottom in one). */
.st-keycols { flex-direction: row; }
.st-keycol { width: 50%; flex-direction: column; }
.st-keycol .st-key { min-width: 110px; margin-right: 12px; }
.st-keycol .st-keywhat { font-size: 17px; flex-shrink: 1; white-space: normal; }
.mm-root .mm-slot .mm-detail { white-space: normal; }
