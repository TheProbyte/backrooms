/* Main menu, styled like the F5 camcorder menu (CamcorderMenu.uss): a navy box with a thin white frame on the left of
   the picture, white capitals with a dark drop shadow, the item under the cursor on an amber bar with a play arrow. */

.mm-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.mm-root .unity-label, .mm-root .unity-text-element {
    color: rgb(242, 246, 255); letter-spacing: 1px; margin: 0; padding: 0;
    text-shadow: 2px 2px 0 rgba(0, 0, 20, 0.9);
}

.mm-panel {
    position: absolute; left: 8%; top: 25%; width: 430px;
    background-color: rgba(10, 22, 70, 0.92);
    border-width: 2px; border-color: rgba(225, 232, 255, 0.9);
    padding: 12px 14px 12px 14px;
}
.mm-panel.mm-wide { width: 640px; top: 19%; }

.mm-header { flex-direction: row; align-items: flex-end; margin: 0 2px 6px 2px; }
.mm-root .mm-title { font-size: 30px; -unity-font-style: bold; letter-spacing: 4px; }
.mm-root .mm-page { font-size: 17px; margin-left: 16px; margin-bottom: 5px; flex-grow: 1; color: rgb(170, 200, 255); letter-spacing: 2px; }
.mm-rule { height: 2px; background-color: rgba(225, 232, 255, 0.75); margin: 2px 0 10px 0; }

.mm-list { flex-direction: column; }

/* A menu item: the arrow column and the words. */
.mm-item { flex-direction: row; align-items: center; padding: 6px 10px 6px 4px; margin: 2px 0; }
.mm-root .mm-cursor { width: 34px; font-size: 26px; -unity-text-align: middle-center; opacity: 0; }
.mm-root .mm-text { font-size: 30px; letter-spacing: 5px; -unity-font-style: bold; }
.mm-item.mm-sel { background-color: rgb(255, 196, 60); }
.mm-root .mm-item.mm-sel .unity-label { color: rgb(10, 22, 70); text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.mm-root .mm-item.mm-sel .mm-cursor { opacity: 1; }
.mm-item.mm-small .mm-text { font-size: 22px; letter-spacing: 4px; }

/* A save slot: its name and what is on it, and an ERASE tag on the right. */
.mm-slot { align-items: flex-start; padding: 10px 10px 10px 4px; margin: 4px 0; border-width: 1px; border-color: rgba(225, 232, 255, 0.45); }
.mm-slot.mm-sel { border-color: rgb(255, 196, 60); }
.mm-slot .mm-cursor { margin-top: 2px; }
.mm-slotbody { flex-grow: 1; flex-direction: column; }
.mm-root .mm-slotname { font-size: 26px; letter-spacing: 4px; -unity-font-style: bold; }
.mm-root .mm-detail { font-size: 16px; letter-spacing: 1px; margin-top: 4px; color: rgb(170, 200, 255); }
.mm-root .mm-empty { font-size: 18px; letter-spacing: 2px; margin-top: 6px; color: rgb(255, 196, 60); }
.mm-root .mm-erase {
    font-size: 14px; letter-spacing: 2px; padding: 4px 10px; margin-top: 2px;
    border-width: 1px; border-color: rgba(225, 232, 255, 0.6); -unity-text-align: middle-center;
}
.mm-root .mm-erase:hover { background-color: rgb(242, 246, 255); color: rgb(10, 22, 70); text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.mm-root .mm-erase.mm-armed { background-color: rgb(200, 40, 30); border-color: rgb(255, 120, 100); color: rgb(255, 255, 255); }
.mm-root .mm-slot.mm-sel .mm-erase { border-color: rgba(10, 22, 70, 0.6); }

.mm-root .mm-note { font-size: 20px; letter-spacing: 2px; margin: 8px 4px 6px 4px; }
.mm-root .mm-desc { font-size: 16px; color: rgb(170, 200, 255); margin: 0 4px 14px 4px; white-space: normal; letter-spacing: 0; }

.mm-root .mm-hint { font-size: 13px; color: rgb(170, 200, 255); margin: 10px 2px 0 2px; letter-spacing: 1px; }

/* Co-op (2026-11-05): a row with a text field (your name, the host's address, the port). */
.mm-fieldrow { padding: 4px 10px 4px 4px; }
.mm-root .mm-fieldlabel { font-size: 22px; letter-spacing: 4px; -unity-font-style: bold; width: 150px; }
.mm-field { flex-grow: 1; margin: 0; }
.mm-field .unity-base-text-field__input, .mm-field .unity-text-field__input {
    background-color: rgba(0, 0, 30, 0.65); border-width: 1px; border-color: rgba(225, 232, 255, 0.7); border-radius: 0;
    font-size: 22px; padding: 4px 8px; color: rgb(242, 246, 255); -unity-font-style: bold;
}
.mm-root .mm-field .unity-text-element { color: rgb(242, 246, 255); }
.mm-item.mm-sel .mm-field .unity-base-text-field__input { border-color: rgb(10, 22, 70); }
.mm-root .mm-panel.mm-wide .mm-note { white-space: normal; }

/* The company stripe under the title (2026-11-06): hidden in the Classic look. */
.mm-stripe { display: none; flex-direction: row; height: 6px; margin: -6px 0 10px 0; }
.mm-s1, .mm-s2, .mm-s3 { flex-grow: 1; }

/* YOUR LOOK (Menu/LookMenu.cs): the choices beside an ID card with the live picture of your suited head. */
.mm-panel.lk-panel { width: 940px; top: 12%; }
.lk-body { flex-direction: row; align-items: flex-start; }
.lk-list { flex-grow: 1; margin-right: 18px; }
.lk-option { padding: 3px 10px 3px 4px; margin: 1px 0; }
.mm-root .lk-label { font-size: 20px; letter-spacing: 3px; -unity-font-style: bold; width: 210px; }
.mm-root .lk-value { font-size: 20px; letter-spacing: 2px; -unity-font-style: bold; flex-grow: 1; }
.lk-option .mm-field .unity-base-text-field__input, .lk-option .mm-field .unity-text-field__input { font-size: 18px; padding: 2px 8px; }
.lk-card {
    width: 300px; padding: 10px; flex-shrink: 0;
    background-color: rgba(242, 246, 255, 0.10); border-width: 2px; border-color: rgba(225, 232, 255, 0.75);
}
.lk-preview { width: 280px; height: 350px; border-width: 1px; border-color: rgba(225, 232, 255, 0.5); }
.mm-root .lk-cardtext { font-size: 18px; letter-spacing: 2px; margin-top: 8px; -unity-font-style: bold; white-space: normal; }

/* ---- The Overflow look (2026-11-06, Docs/StyleSheet.md): the company's own paperwork. Chocolate, warm cream type, the
   item under the cursor on the company amber, the orange, gold and avocado stripe under the title. ---- */
.mm-ov .unity-label, .mm-ov .unity-text-element { color: rgb(243, 230, 200); text-shadow: 2px 2px 0 rgba(30, 18, 8, 0.9); }
.mm-ov .mm-panel { background-color: rgba(59, 42, 30, 0.95); border-color: rgb(240, 162, 30); border-radius: 6px; }
.mm-ov .mm-rule { background-color: rgb(240, 162, 30); }
.mm-ov .mm-stripe { display: flex; }
.mm-ov .mm-s1 { background-color: rgb(217, 102, 31); }
.mm-ov .mm-s2 { background-color: rgb(232, 178, 58); }
.mm-ov .mm-s3 { background-color: rgb(124, 138, 46); }
.mm-root.mm-ov .mm-page, .mm-root.mm-ov .mm-desc, .mm-root.mm-ov .mm-hint, .mm-root.mm-ov .mm-detail { color: rgb(205, 180, 138); }
.mm-ov .mm-item { border-radius: 4px; }
.mm-ov .mm-item.mm-sel { background-color: rgb(240, 162, 30); }
.mm-root.mm-ov .mm-item.mm-sel .unity-label { color: rgb(59, 42, 30); }
.mm-ov .mm-slot { border-color: rgba(243, 230, 200, 0.35); border-radius: 4px; }
.mm-ov .mm-slot.mm-sel { border-color: rgb(240, 162, 30); }
.mm-root.mm-ov .mm-empty { color: rgb(232, 178, 58); }
.mm-ov .mm-field .unity-base-text-field__input, .mm-ov .mm-field .unity-text-field__input {
    background-color: rgba(30, 18, 8, 0.6); border-color: rgba(243, 230, 200, 0.6); color: rgb(243, 230, 200); border-radius: 3px;
}
.mm-root.mm-ov .mm-field .unity-text-element { color: rgb(243, 230, 200); }
.mm-ov .mm-item.mm-sel .mm-field .unity-base-text-field__input { border-color: rgb(59, 42, 30); }
.mm-ov .lk-card { background-color: rgb(243, 230, 200); border-color: rgb(240, 162, 30); border-radius: 8px; }
.mm-ov .lk-preview { border-color: rgba(59, 42, 30, 0.6); }
.mm-root.mm-ov .lk-cardtext { color: rgb(59, 42, 30); text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
