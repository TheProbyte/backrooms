// Backrooms light grid. Fills a 3D clipmap (0.6 m texels, toroidal in x/z) with the light of every fixture
// that is not currently a real URP light, and a 2D bounce field (1.2 m cells) from all fixtures.
// Light is blocked by walls and headers using the layout occupancy (see LightGridMath.cs, which mirrors
// this file on the CPU for tests and debug views). Only dirty boxes are recomputed each frame.
#pragma kernel Direct
#pragma kernel BounceSource
#pragma kernel BounceDiffuse
#pragma kernel FaceLight
#pragma kernel ProbeCopy
#pragma kernel ProbeTrace

#include "Assets/Backrooms/Shaders/LightGridCommon.hlsl"
#include "Assets/Backrooms/Shaders/LightGridOcclusion.hlsl"

struct GridLight
{
    float3 pos;      float range;
    float3 color;    float cosOuter;     // colour x intensity x the grid's share (0 while it is a real light)
    float3 dir;      float cosInner;     // spot axis, zero for samplePosition lights
    float3 colorAll; float storey;       // full colour x intensity x power
    float2 halfSize; float2 padding;     // padding.x: bounce and haze use colorAll x (1 + x) (a faulty tube's smoothed power)
};

// The light a fixture gives to bounce and haze: its power smoothed over a fraction of a second, so a stuttering tube does
// not make the bounce and haze (updated in slices and boxes) pop in patches. Its direct light still flickers exactly.
float3 BounceColor(GridLight L) { return L.colorAll * (1.0 + L.padding.x); }

RWTexture3D<float4> _GridA;          // rgb: irradiance facing the lights, a: luminance-weighted direction y
RWTexture3D<float4> _GridB;          // x, y: luminance-weighted direction x and z; z: all light's luminance (haze), w: 0
StructuredBuffer<uint> _Occ;         // layout occupancy: [storey][z][x], toroidal
StructuredBuffer<GridLight> _Lights;
StructuredBuffer<uint2> _Tiles;      // (first index, count) per tile
StructuredBuffer<uint> _TileLights;

int4 _GridSize;          // texels x, y, z; occupancy size (cells)
int4 _BoxMin, _BoxSize;  // absolute texel coordinates of the box to fill
int4 _TileInfo;          // texels per tile, tiles per axis
float4 _GridMisc;        // x: storey pitch, y: floor albedo (bounce), z: bounce spread, w: near/far split radius (0 = whole light)
float4 _GridMisc2;       // x: haze on (0/1)
int4 _CellMin;           // absolute cell of the bounce window's corner (x, z)

struct SurfaceRecord { float4 floor; float4 wall; float4 ceiling; };
StructuredBuffer<SurfaceRecord> _Surfaces;
RWTexture2D<float4> _WallSrc, _DirectionSrc;
Texture2D<float4> _WallSrcIn, _DirectionSrcIn, _WallIn, _DirectionIn;
RWTexture2D<float4> _WallOut, _DirectionOut;
RWTexture2D<float4> _BounceSrc;
Texture2D<float4> _BounceSrcIn;
Texture2D<float4> _BounceIn;
RWTexture2D<float4> _BounceOut;

static const float3 LUM = float3(0.2126, 0.7152, 0.0722);

// Sizes are powers of two, so wrapping is a mask (correct for negative values too).
int Wrap(int v, int n) { return v & (n - 1); }

uint Occ(int2 cell, uint storey)
{
    if (storey > 1u) return 0u;
    int n = _GridSize.w;
    return _Occ[(storey * (uint)n + (uint)Wrap(cell.y, n)) * (uint)n + (uint)Wrap(cell.x, n)];
}

uint TileIndex(int2 texelXZ)
{
    int tx = Wrap((int)floor(texelXZ.x / (float)_TileInfo.x), _TileInfo.y);
    int tz = Wrap((int)floor(texelXZ.y / (float)_TileInfo.x), _TileInfo.y);
    return (uint)(tz * _TileInfo.y + tx);
}

// URP's falloffs (UnityEngine light, linear intensity).
float DistanceAtten(float d2, float range)
{
    float f = d2 / (range * range);
    float s = saturate(1.0 - f * f);
    return s * s / max(d2, 0.0001);
}

// Fixture emission profile, as LGrid_AngleAtten (LightGridSample.hlsl): Lambertian at full spread.
float AngleAtten(float cosAngle, float cosOuter, float cosInner)
{
    float inv = 1.0 / max(cosInner - cosOuter, 0.001);
    return saturate(cosAngle * inv - cosOuter * inv);
}

uint StoreyAt(float y) { return y >= _GridMisc.x ? 1u : 0u; }

// Line of sight through the layout: cell-edge crossings in 2D, with the ray's height checked against
// each opening's top. Changing storey is only possible through a well (open-above cells).
bool Visible(float3 P, float3 Q)
{
    float pitch = _GridMisc.x;
    bool visible = true;
    if (StoreyAt(P.y) != StoreyAt(Q.y))
    {
        float ts = (pitch - P.y) / (Q.y - P.y);
        float3 X = lerp(P, Q, ts);
        uint os = Occ((int2)floor(X.xz / LG_CELL), 0u);
        visible = (os & LG_OPENABOVE) != 0u;      // otherwise the ray goes through a floor slab
    }
    float2 a = P.xz / LG_CELL, b = Q.xz / LG_CELL;
    int2 c = (int2)floor(a), e = (int2)floor(b);
    float2 d = b - a;
    int2 stp = int2(d.x > 0 ? 1 : (d.x < 0 ? -1 : 0), d.y > 0 ? 1 : (d.y < 0 ? -1 : 0));
    float2 tDelta = float2(stp.x != 0 ? abs(1.0 / d.x) : 1e30, stp.y != 0 ? abs(1.0 / d.y) : 1e30);
    float2 tMax = float2(stp.x > 0 ? (c.x + 1 - a.x) * tDelta.x : (stp.x < 0 ? (a.x - c.x) * tDelta.x : 1e30),
                         stp.y > 0 ? (c.y + 1 - a.y) * tDelta.y : (stp.y < 0 ? (a.y - c.y) * tDelta.y : 1e30));
    [loop] for (int i = 0; i < 48 && visible; i++)
    {
        if (c.x == e.x && c.y == e.y) break;
        bool stepX = tMax.x < tMax.y;
        float t = stepX ? tMax.x : tMax.y;
        if (t > 1.0) break;
        float y = lerp(P.y, Q.y, t);
        uint storey = StoreyAt(y);
        int2 n = c + (stepX ? int2(stp.x, 0) : int2(0, stp.y));
        int2 owner = stepX ? int2(max(c.x, n.x), c.y) : int2(c.x, max(c.y, n.y));
        uint o = Occ(owner, storey);
        uint kind = stepX ? LG_WestKind(o) : LG_SouthKind(o);
        float top = (stepX ? LG_WestTop(o) : LG_SouthTop(o)) + storey * pitch;
        // A broken wall lets light through where it is open right through. (HLSL's && does not skip its right side.)
        bool hole = false;
        [branch] if (kind == LG_EDGE_WALL && LG_Holed(o, stepX))
            hole = LG_HoleOpen(owner, stepX, storey, (stepX ? lerp(P.z, Q.z, t) - owner.y * LG_CELL : lerp(P.x, Q.x, t) - owner.x * LG_CELL), y - storey * pitch, false);
        if (!LG_Loaded(o) || (kind == LG_EDGE_WALL ? !hole : y > top + 0.02)) { visible = false; break; }
        c = n;
        if (stepX) tMax.x += tDelta.x; else tMax.y += tDelta.y;
    }
    return visible;
}

// A texel stands for a 0.6 m box but is tested at its centre only, which lets light peek past wall ends and
// header edges into texels that are mostly shadowed (stair-stepped streaks along corners). So a texel only
// counts as lit when points a little way around its centre are lit too (conservative: light edges erode
// by a few cm instead of leaking).
bool VisibleSolid(float3 P, float3 Q)
{
    if (!Visible(P, Q)) return false;
    const float k = 0.22;
    return Visible(P, Q + float3(k, 0, 0)) && Visible(P, Q - float3(k, 0, 0))
        && Visible(P, Q + float3(0, 0, k)) && Visible(P, Q - float3(0, 0, k))
        && Visible(P, Q + float3(0, k, 0)) && Visible(P, Q - float3(0, k, 0));
}

float Attenuation(GridLight L, float3 Q, out float3 toLight)
{
    float3 delta = L.pos - Q;
    if (dot(delta, delta) >= L.range * L.range) { toLight = 0; return 0; }
    float sizeWeight = 1.0 - smoothstep(36.0, 64.0, dot(delta, delta));
    bool quad = dot(L.halfSize, L.halfSize) > 0 && sizeWeight > 0;
    int samples = quad ? 4 : 1;
    float sum = 0; float3 moment = 0;
    [loop] for (int s = 0; s < samples; s++)
    {
        float3 d = LG_EmitterPoint(L.pos, L.halfSize * sizeWeight, s, quad) - Q;
        float d2 = dot(d, d);
        float3 dir = d * rsqrt(max(d2, 1e-8));
        float a = DistanceAtten(max(d2, 0.04), L.range);
        if (dot(L.dir, L.dir) > 0.5) a *= AngleAtten(dot(L.dir, -dir), L.cosOuter, L.cosInner);
        sum += a; moment += dir * a;
    }
    toLight = sum > 1e-8 ? moment / sum : 0;
    return sum / samples;
}

[numthreads(4, 4, 4)]
void Direct(uint3 id : SV_DispatchThreadID)
{
    if (any((int3)id >= _BoxSize.xyz)) return;
    int3 t = _BoxMin.xyz + (int3)id;
    if (t.y < 0 || t.y >= _GridSize.y) return;
    float3 Q = (float3(t) + 0.5) * LG_TEXEL;
    int3 w = int3(Wrap(t.x, _GridSize.x), t.y, Wrap(t.z, _GridSize.z));
    float4 A = 0, B = 0;
    uint st = StoreyAt(Q.y);
    uint o = Occ((int2)floor(Q.xz / LG_CELL), st);
    float rel = Q.y - st * _GridMisc.x;
    bool hazeOn = _GridMisc2.x > 0.5;
    float haze = 0;
    if (LG_Loaded(o) && rel <= LG_Ceiling(o))
    {
        uint2 range = _Tiles[TileIndex(t.xz)];
        for (uint i = 0; i < range.y; i++)
        {
            GridLight L = _Lights[_TileLights[range.x + i]];
            // Haze sees every fixture's whole light (real lights too); the texture only this grid's share.
            float3 hazeColor = BounceColor(L);
            bool wantHaze = hazeOn && dot(hazeColor, hazeColor) > 0.0;
            if (dot(L.color, L.color) <= 0.0 && !wantHaze) continue;
            // Per-pixel mode with a near/far split: only the far part of each fixture's light is stored here
            // (the material shader adds the near part exactly; the weights match LGrid_NearWeight).
            float far = _GridMisc.w > 0 ? smoothstep(_GridMisc.w - 1, _GridMisc.w + 1, distance(L.pos, Q)) : 1;
            if (dot(L.color, L.color) <= 0.0) far = 0;
            if (far <= 0 && !wantHaze) continue;
            // A fixture's pool is narrow and very bright near the light (a wall pool is only a texel or two wide at
            // its top), so a single sample per 0.6 m texel aliases into boxes. The falloff is averaged over eight
            // points inside the texel instead; line of sight is still tested once (conservative, at the centre).
            float attSum = 0; float3 dirSum = 0;
            [unroll] for (int s = 0; s < 8; s++)
            {
                float3 off = float3((s & 1) ? 0.15 : -0.15, (s & 2) ? 0.15 : -0.15, (s & 4) ? 0.15 : -0.15);
                float3 tl;
                float a = Attenuation(L, Q + off, tl);
                attSum += a; dirSum += a * tl;
            }
            if (attSum <= 8e-6) continue;
            if (far <= 0)
            {
                // Haze only: one line of sight is enough (a few cm of erosion at corners does not show in the air).
                if (Visible(L.pos, Q)) haze += dot(hazeColor, LUM) * attSum * 0.125;
                continue;
            }
            if (!VisibleSolid(L.pos, Q)) continue;
            if (wantHaze) haze += dot(hazeColor, LUM) * attSum * 0.125;
            float att = attSum * 0.125 * far;
            dirSum *= far;
            float3 e = L.color * att;
            float lum = dot(L.color, LUM);
            A.rgb += e;
            A.w += lum * dirSum.y * 0.125;
            B.xy += lum * dirSum.xz * 0.125;
        }
    }
    B.z = haze;
    _GridA[w] = A;
    _GridB[w] = B;
}

// Reflected radiance from floor and wall patches, separately for both storeys.
// The first directional moment of wall radiance preserves which side supplied the bounce.
float3 SurfaceLight(float3 Q, float3 normal, uint2 lights)
{
    float3 sum = 0;
    [loop] for (uint i = 0; i < lights.y; i++)
    {
        GridLight L = _Lights[_TileLights[lights.x + i]];
        float3 bounceColor = BounceColor(L);
        if (dot(bounceColor, bounceColor) <= 0) continue;
        float3 direction;
        float att = Attenuation(L, Q, direction);
        float facing = saturate(dot(normal, direction));
        if (att * facing <= 1e-6 || !Visible(L.pos, Q)) continue;
        sum += bounceColor * att * facing * LocalLightVisibility(Q, normal, L.pos);
    }
    return sum;
}

[numthreads(8, 8, 1)]
void BounceSource(uint3 id : SV_DispatchThreadID)
{
    int n = _GridSize.w;
    if ((int)id.x >= n || (int)id.y >= n || id.z > 1) return;
    uint storey = id.z;
    int2 cell = _CellMin.xy + (int2)id.xy;
    int2 wi = int2(Wrap(cell.x, n), Wrap(cell.y, n) + storey * n);
    uint o = Occ(cell, storey);
    uint surfaceIndex = (storey * n + Wrap(cell.y, n)) * n + Wrap(cell.x, n);
    SurfaceRecord material = _Surfaces[surfaceIndex];
    float3 floorSum = 0, wallSum = 0;
    float4 directionSum = 0;
    if (LG_Loaded(o))
    {
        float3 centre = float3((cell.x + 0.5) * LG_CELL, storey * _GridMisc.x, (cell.y + 0.5) * LG_CELL);
        uint2 lights = _Tiles[TileIndex(cell * 2)];
        if ((o & LG_NOFLOOR) == 0u)
            floorSum = SurfaceLight(centre + float3(0, 0.05, 0), float3(0, 1, 0), lights) * material.floor.rgb * (_GridMisc.y / 0.25);
        [unroll] for (int side = 0; side < 4; side++)
        {
            int2 offset = side == 0 ? int2(-1, 0) : side == 1 ? int2(1, 0) : side == 2 ? int2(0, -1) : int2(0, 1);
            uint edge = side == 0 ? LG_WestKind(o) : side == 1 ? LG_WestKind(Occ(cell + offset, storey)) : side == 2 ? LG_SouthKind(o) : LG_SouthKind(Occ(cell + offset, storey));
            if (edge != LG_EDGE_WALL) continue;
            float3 towardWall = float3(offset.x, 0, offset.y);
            float3 samplePosition = centre + towardWall * (LG_CELL * 0.5 - 0.05) + float3(0, LG_Ceiling(o) * 0.55, 0);
            float3 radiance = SurfaceLight(samplePosition, -towardWall, lights) * material.wall.rgb * 0.25;
            wallSum += radiance;
            float lum = dot(radiance, LUM);
            directionSum += float4(towardWall * lum, lum);
        }
    }
    _BounceSrc[wi] = float4(floorSum, 1);
    _WallSrc[wi] = float4(wallSum, 1);
    _DirectionSrc[wi] = directionSum;
}

float EdgePass(uint kind) { return kind == LG_EDGE_OPEN ? 1.0 : 0.0; }

// Diffuse only across open floor. Doors/arches are not a license to smear light through their wall;
// direct rays entering an opening create their own reflected source in the receiving room.
[numthreads(8, 8, 1)]
void BounceDiffuse(uint3 id : SV_DispatchThreadID)
{
    int n = _GridSize.w;
    if ((int)id.x >= n || (int)id.y >= n || id.z > 1) return;
    uint storey = id.z;
    int2 cell = _CellMin.xy + (int2)id.xy;
    int layer = storey * n;
    int2 wi = int2(Wrap(cell.x, n), Wrap(cell.y, n) + layer);
    uint o = Occ(cell, storey);
    float3 floorAcc = _BounceIn[wi].rgb, wallAcc = _WallIn[wi].rgb;
    float4 directionAcc = _DirectionIn[wi];
    float count = 1;
    if (LG_Loaded(o))
    {
        [unroll] for (int side = 0; side < 4; side++)
        {
            int2 offset = side == 0 ? int2(-1, 0) : side == 1 ? int2(1, 0) : side == 2 ? int2(0, -1) : int2(0, 1);
            int2 absoluteId = (int2)id.xy + offset;
            if (any(absoluteId < 0) || any(absoluteId >= n)) continue;
            uint edge = side == 0 ? LG_WestKind(o) : side == 1 ? LG_WestKind(Occ(cell + offset, storey)) : side == 2 ? LG_SouthKind(o) : LG_SouthKind(Occ(cell + offset, storey));
            if (EdgePass(edge) == 0 || !LG_Loaded(Occ(cell + offset, storey))) continue;
            int2 other = int2(Wrap(cell.x + offset.x, n), Wrap(cell.y + offset.y, n) + layer);
            floorAcc += _BounceIn[other].rgb; wallAcc += _WallIn[other].rgb; directionAcc += _DirectionIn[other]; count++;
        }
    }
    uint surfaceIndex = (storey * n + Wrap(cell.y, n)) * n + Wrap(cell.x, n);
    float3 own = _BounceSrcIn[wi].rgb;
    float3 floorResult = lerp(own, floorAcc / count, _GridMisc.z);
    // This belongs to the fixed source, not an addition after each iteration (which would accumulate energy).
    float3 ceilingReturn = own * _Surfaces[surfaceIndex].ceiling.rgb * 0.08;
    float3 wallResult = lerp(_WallSrcIn[wi].rgb + ceilingReturn, wallAcc / count, _GridMisc.z);
    float4 ownDirection = _DirectionSrcIn[wi];
    ownDirection.w += dot(ceilingReturn, LUM); // isotropic return adds energy, but no preferred direction
    _BounceOut[wi] = float4(floorResult, 1);
    _WallOut[wi] = float4(wallResult, 1);
    _DirectionOut[wi] = lerp(ownDirection, directionAcc / count, _GridMisc.z);
}

// ================= Traced bounce (F5 > LIGHT > Traced bounce) =================
// Two probes per 1.2 m layout cell and storey (low and high, see LG_ProbeHeights), each an L1 spherical harmonic of the
// light arriving from every direction. Each frame a quarter of them cast 64 rays through the layout (walls, shut doors,
// floors, ceilings, header beams, nearby furniture boxes) and read what each ray hits from a cache of the light on every
// cell's floor, ceiling and walls (FaceLight: the fixtures' direct light times the surface's colour), plus that surface's own
// bounce from last frame's probes (more bounces). New estimates blend with the old (temporal accumulation); a probe that
// changes a lot blends faster. Walls lie between probes, so nothing traced leaks through them, and the shader keeps its
// sample on the room's own side of every wall when it interpolates (LGrid_ProbeIrradiance).

float4 _ProbeParams;     // x: frame, y: hysteresis, z: second bounce (0..1), w: colour bleed (0..2)
float4 _ProbeParams2;    // x: noise-aware blending (0/1), y: most history kept once still (settle)
int4 _ProbeInfo;         // x: slice count, y: rays per thread, z: this frame's probe slice, w: this frame's face slice (-1 = all)
RWStructuredBuffer<float4> _FaceLightOut;    // per cell and storey, 12 entries (see FaceSlot)
StructuredBuffer<float4> _FaceLightIn;
Texture2D<float4> _ProbePrevR, _ProbePrevG, _ProbePrevB;
RWTexture2D<float4> _ProbeOutR, _ProbeOutG, _ProbeOutB;
Texture2D<float4> _ProbeInR, _ProbeInG, _ProbeInB;            // ProbeFilter: the probes as traced
RWTexture2D<float4> _ProbeSmoothR, _ProbeSmoothG, _ProbeSmoothB;   // ProbeFilter: what the shaders read
RWStructuredBuffer<uint> _ProbeKey;

// Crawl holes (CrawlPortalSystem): a ray going into one carries the light of the room at the duct's far end, from the light
// sampled at the far mouth each frame (_DuctMouthLight: six axis irradiances per mouth), times how much a 1.9 m duct passes.
#define MAX_HOLES 16
float4 _HolePos[MAX_HOLES];        // xyz: centre of the opening, w: half size
float4 _HoleNormal[MAX_HOLES];     // xyz: out of the hole into this room
float4 _HolePartner[MAX_HOLES];    // xyz: out of the far hole into its room, w: that mouth's row in _DuctMouthLight (-1: none)
int _HoleCount;
float _HoleTransmission;
Texture2D<float4> _DuctMouthLight;

bool HoleRadiance(float3 X, float3 d, out float3 radiance)
{
    radiance = 0;
    [loop] for (int i = 0; i < _HoleCount; i++)
    {
        float3 n = _HoleNormal[i].xyz, rel = X - _HolePos[i].xyz;
        if (dot(d, n) >= 0 || abs(dot(rel, n)) > 0.3) continue;
        float3 right = normalize(cross(float3(0, 1, 0), n));
        float halfSize = _HolePos[i].w;
        if (abs(dot(rel, right)) > halfSize || abs(rel.y) > halfSize) continue;
        int row = (int)_HolePartner[i].w;
        if (row >= 0)
        {
            // Light from the far room arriving at its mouth (on a surface facing out into that room).
            float3 m = _HolePartner[i].xyz, w = m * m;
            float3 E = _DuctMouthLight[int2(m.x >= 0 ? 0 : 1, row)].rgb * w.x + _DuctMouthLight[int2(m.y >= 0 ? 2 : 3, row)].rgb * w.y +
                       _DuctMouthLight[int2(m.z >= 0 ? 4 : 5, row)].rgb * w.z;
            radiance = E * _HoleTransmission;
        }
        return true;
    }
    return false;
}

// FaceLight entries: 0 floor, 1 ceiling, 2..5 walls low (west, east, south, north), 6..9 walls high, 10 floor irradiance.
uint FaceIndex(int2 cell, uint storey)
{
    int n = _GridSize.w;
    return ((storey * (uint)n + (uint)Wrap(cell.y, n)) * (uint)n + (uint)Wrap(cell.x, n)) * 12u;
}

uint ProbeKey(int2 cell, uint storey) { return ((((uint)cell.x * 73856093u) ^ ((uint)cell.y * 19349663u) ^ (storey * 83492791u)) | 1u) & 0xFFFFFFu; }
// _ProbeKey holds the cell's key in its low 24 bits and, above them, how many updates the probe has gone without a real
// change (ProbeTrace: a still room settles over a longer window).
bool ProbeKeyIs(uint stored, uint key) { return (stored & 0xFFFFFFu) == key; }

float3 Bleed(float3 albedo)
{
    float grey = dot(albedo, LUM);
    return max(lerp(grey.xxx, albedo, _ProbeParams.w), 0);
}

bool HasFloor(int2 cell, uint storey, uint o) { return !(storey == 1u && (o & LG_NOFLOOR) != 0u && (Occ(cell, 0u) & LG_OPENABOVE) != 0u); }
bool HasCeiling(uint storey, uint o) { return !(storey == 0u && (o & LG_OPENABOVE) != 0u); }

[numthreads(8, 8, 1)]
void FaceLight(uint3 id : SV_DispatchThreadID)
{
    int n = _GridSize.w;
    if ((int)id.x >= n || (int)id.y >= n || id.z > 1) return;
    if (_ProbeInfo.w >= 0 && (int)((id.x + id.y * 3u) & 3u) != _ProbeInfo.w) return;
    uint storey = id.z;
    int2 cell = _CellMin.xy + (int2)id.xy;
    uint o = Occ(cell, storey);
    uint index = FaceIndex(cell, storey);
    float4 face[12];
    [unroll] for (int k = 0; k < 12; k++) face[k] = 0;
    if (LG_Loaded(o))
    {
        SurfaceRecord material = _Surfaces[index / 12u];
        float3 floorAlbedo = Bleed(material.floor.rgb), wallAlbedo = Bleed(material.wall.rgb), ceilingAlbedo = Bleed(material.ceiling.rgb);
        float base = storey * _GridMisc.x, ceiling = LG_Ceiling(o);
        float3 centre = float3((cell.x + 0.5) * LG_CELL, base, (cell.y + 0.5) * LG_CELL);
        uint2 lights = _Tiles[TileIndex(cell * 2)];
        if (HasFloor(cell, storey, o))
        {
            float3 E = SurfaceLight(centre + float3(0, 0.05, 0), float3(0, 1, 0), lights);
            face[0] = float4(E * floorAlbedo, 1); face[10] = float4(E, 1);
        }
        if (HasCeiling(storey, o))
            face[1] = float4(SurfaceLight(centre + float3(0, ceiling - 0.05, 0), float3(0, -1, 0), lights) * ceilingAlbedo, 1);
        [unroll] for (int side = 0; side < 4; side++)
        {
            int2 offset = side == 0 ? int2(-1, 0) : side == 1 ? int2(1, 0) : side == 2 ? int2(0, -1) : int2(0, 1);
            uint owner = side == 0 || side == 2 ? o : Occ(cell + offset, storey);
            uint kind = side < 2 ? LG_WestKind(owner) : LG_SouthKind(owner);
            float top = side < 2 ? LG_WestTop(owner) : LG_SouthTop(owner);
            float3 towardWall = float3(offset.x, 0, offset.y);
            float lowY = ceiling * 0.3, highY = ceiling * 0.75;
            if (kind != LG_EDGE_WALL)
            {
                // An opening: only the header above it is a surface.
                if (kind == LG_EDGE_OPEN || top >= ceiling - 0.05) continue;
                lowY = highY = 0.5 * (top + ceiling);
            }
            float3 at = centre + towardWall * (LG_CELL * 0.5 - 0.05);
            float3 low = SurfaceLight(at + float3(0, lowY, 0), -towardWall, lights) * wallAlbedo;
            float3 high = lowY == highY ? low : SurfaceLight(at + float3(0, highY, 0), -towardWall, lights) * wallAlbedo;
            face[2 + side] = float4(low, 1); face[6 + side] = float4(high, 1);
        }
    }
    [unroll] for (int j = 0; j < 12; j++) _FaceLightOut[index + j] = face[j];
}

uint ProbeSlab(uint storey, uint layer) { return storey * 2u + layer; }
uint2 ProbeTexel(int2 cell, uint slab) { int n = _GridSize.w; return uint2(Wrap(cell.x, n), Wrap(cell.y, n) + slab * n); }

[numthreads(8, 8, 1)]
void ProbeCopy(uint3 id : SV_DispatchThreadID)
{
    int n = _GridSize.w;
    if ((int)id.x >= n || (int)id.y >= n || id.z > 3) return;
    uint slab = id.z, storey = slab >> 1;
    int2 cell = _CellMin.xy + (int2)id.xy;
    uint2 texel = ProbeTexel(cell, slab);
    // A probe holds light only for the cell it was traced in (the window wraps): anything else is dark until traced.
    bool valid = ProbeKeyIs(_ProbeKey[(slab * (uint)n + texel.y - slab * n) * (uint)n + texel.x], ProbeKey(cell, storey)) && LG_Loaded(Occ(cell, storey));
    _ProbeOutR[texel] = valid ? _ProbePrevR[texel] : 0;
    _ProbeOutG[texel] = valid ? _ProbePrevG[texel] : 0;
    _ProbeOutB[texel] = valid ? _ProbePrevB[texel] : 0;
}

// Irradiance (URP units: what multiplies the albedo) from an L1 radiance SH per colour channel.
float3 EvalSH(float4 r, float4 g, float4 b, float3 N)
{
    float4 basis = float4(0.282095, 0.325735 * N);   // Y00 and (2/3) Y1 n
    return max(float3(dot(r, basis), dot(g, basis), dot(b, basis)), 0);
}

float3 PrevIrradiance(int2 cell, uint storey, float y, float3 N)
{
    uint o = Occ(cell, storey);
    if (!LG_Loaded(o)) return 0;
    float2 h = LG_ProbeHeights(o, storey * _GridMisc.x);
    float t = saturate((y - h.x) / max(h.y - h.x, 0.1));
    uint2 a = ProbeTexel(cell, ProbeSlab(storey, 0)), b = ProbeTexel(cell, ProbeSlab(storey, 1));
    float3 e0 = EvalSH(_ProbePrevR[a], _ProbePrevG[a], _ProbePrevB[a], N);
    float3 e1 = EvalSH(_ProbePrevR[b], _ProbePrevG[b], _ProbePrevB[b], N);
    return lerp(e0, e1, t);
}

// Nearest furniture box along a ray (boxes binned for the probe's tile), ignoring a box the ray starts inside.
bool FurnitureHit(float3 P, float3 d, float maxT, out float tHit, out float3 normal)
{
    tHit = maxT; normal = 0;
    if (_LocalOccInfo.z < 0.5) return false;
    uint2 range = LocalOccRange(P);
    bool hit = false;
    [loop] for (uint i = 0; i < range.y; i++)
    {
        LocalOccBox box = _LocalOccBoxes[_LocalOccIndices[range.x + i]];
        float3 rel = box.centre.xyz - P;
        float along = dot(rel, d);
        if (along < -box.centre.w || along - box.centre.w > tHit || dot(rel, rel) - along * along > box.centre.w * box.centre.w) continue;
        float2 span = LocalOccIntersection(P, d, box);
        if (span.x <= 0.02 || span.y < span.x || span.x >= tHit) continue;
        tHit = span.x; hit = true;
        float3 local = LocalOccRotate(P + d * span.x - box.centre.xyz, box.inverseRotation) / max(box.halfSize.xyz, 1e-4);
        float3 a = abs(local);
        float3 n = a.x > a.y && a.x > a.z ? float3(sign(local.x), 0, 0) : a.y > a.z ? float3(0, sign(local.y), 0) : float3(0, 0, sign(local.z));
        float4 q = box.inverseRotation; q.xyz = -q.xyz;              // back to world
        normal = LocalOccRotate(n, q);
    }
    return hit;
}

// Walks a ray through the layout's cells from P (inside a loaded cell). Returns what it hit and the light leaving it.
float3 TraceRadiance(float3 P, float3 d, uint storey)
{
    const float maxT = 18.0;
    float pitch = _GridMisc.x;
    int2 c = (int2)floor(P.xz / LG_CELL);
    int2 stp = int2(d.x >= 0 ? 1 : -1, d.z >= 0 ? 1 : -1);
    float2 dxz = float2(abs(d.x) > 1e-6 ? d.x : 1e-6 * stp.x, abs(d.z) > 1e-6 ? d.z : 1e-6 * stp.y);
    float2 tDelta = LG_CELL / abs(dxz);
    float2 tMax = ((float2(c) + float2(stp > 0)) * LG_CELL - P.xz) / dxz;
    float furnitureT; float3 furnitureN;
    bool furniture = FurnitureHit(P, d, 4.0, furnitureT, furnitureN);
    float3 albedoFurniture = Bleed(float3(0.32, 0.3, 0.28));
    [loop] for (int i = 0; i < 40; i++)
    {
        uint o = Occ(c, storey);
        if (!LG_Loaded(o)) return 0;
        float base = storey * pitch, ceiling = base + LG_Ceiling(o);
        float tExit = min(tMax.x, tMax.y);
        uint index = FaceIndex(c, storey);
        // Furniture in front of everything in this cell.
        if (furniture && furnitureT <= tExit)
        {
            float3 X = P + d * furnitureT;
            float up = saturate(0.5 + 0.5 * furnitureN.y);
            float3 direct = _FaceLightIn[index + 10].rgb * up * up * albedoFurniture;
            return direct + albedoFurniture * PrevIrradiance(c, storey, X.y, furnitureN) * _ProbeParams.z;
        }
        // Floor or ceiling of this cell (or through it, to the other storey, at a well).
        if (d.y < 0)
        {
            float tf = (base - P.y) / d.y;
            if (tf <= tExit)
            {
                if (HasFloor(c, storey, o))
                {
                    if (tf > maxT) return 0;
                    float3 albedo = Bleed(_Surfaces[index / 12u].floor.rgb);
                    return _FaceLightIn[index].rgb + albedo * PrevIrradiance(c, storey, base + 0.05, float3(0, 1, 0)) * _ProbeParams.z;
                }
                storey = 0u; continue;
            }
        }
        else if (d.y > 0)
        {
            float tc = ((HasCeiling(storey, o) ? ceiling : pitch) - P.y) / d.y;
            if (tc <= tExit)
            {
                if (HasCeiling(storey, o))
                {
                    if (tc > maxT) return 0;
                    float3 albedo = Bleed(_Surfaces[index / 12u].ceiling.rgb);
                    return _FaceLightIn[index + 1].rgb + albedo * PrevIrradiance(c, storey, ceiling - 0.05, float3(0, -1, 0)) * _ProbeParams.z;
                }
                if (storey == 1u) return 0;
                storey = 1u; continue;
            }
        }
        if (tExit > maxT) return 0;
        // Across a cell edge: a wall, a header above an opening, or on into the next cell.
        bool stepX = tMax.x < tMax.y;
        float y = P.y + d.y * tExit;
        int2 next = c + (stepX ? int2(stp.x, 0) : int2(0, stp.y));
        int2 ownerCell = stepX ? int2(max(c.x, next.x), c.y) : int2(c.x, max(c.y, next.y));
        uint owner = Occ(ownerCell, storey);
        if (!LG_Loaded(owner)) return 0;
        uint kind = stepX ? LG_WestKind(owner) : LG_SouthKind(owner);
        float top = (stepX ? LG_WestTop(owner) : LG_SouthTop(owner)) + base;
        // Through a hole in a broken wall, on into the next room.
        float3 X = P + d * tExit;
        bool hole = false;
        [branch] if (kind == LG_EDGE_WALL && LG_Holed(owner, stepX))
            hole = LG_HoleOpen(ownerCell, stepX, storey, stepX ? X.z - ownerCell.y * LG_CELL : X.x - ownerCell.x * LG_CELL, y - base, false);
        if (kind == LG_EDGE_WALL ? !hole : y > top + 0.02)
        {
            float3 holeLight;
            if (_HoleCount > 0 && HoleRadiance(P + d * tExit, d, holeLight)) return holeLight;   // into a crawl hole
            int side = stepX ? (stp.x < 0 ? 0 : 1) : (stp.y < 0 ? 2 : 3);
            float rel = y - base, h = LG_Ceiling(o);
            float t = saturate((rel - 0.3 * h) / max(0.45 * h, 0.1));
            float3 albedo = Bleed(_Surfaces[index / 12u].wall.rgb);
            float3 wallN = stepX ? float3(-stp.x, 0, 0) : float3(0, 0, -stp.y);
            return lerp(_FaceLightIn[index + 2 + side].rgb, _FaceLightIn[index + 6 + side].rgb, t)
                 + albedo * PrevIrradiance(c, storey, y, wallN) * _ProbeParams.z;
        }
        c = next;
        if (stepX) tMax.x += tDelta.x; else tMax.y += tDelta.y;
    }
    return 0;
}

float3 SphericalFibonacci(float i, float count)
{
    float phi = 6.2831853 * frac(i * 0.6180339887);
    float cosTheta = 1.0 - (2.0 * i + 1.0) / count;
    float sinTheta = sqrt(saturate(1.0 - cosTheta * cosTheta));
    return float3(cos(phi) * sinTheta, cosTheta, sin(phi) * sinTheta);
}

uint Hash(uint x) { x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16; return x; }

float3x3 RandomRotation(uint seed)
{
    float u1 = (Hash(seed) & 0xffffu) / 65535.0, u2 = (Hash(seed * 3u + 1u) & 0xffffu) / 65535.0, u3 = (Hash(seed * 7u + 2u) & 0xffffu) / 65535.0;
    // Uniform random unit quaternion (Shoemake).
    float4 q = float4(sqrt(1 - u1) * sin(6.2831853 * u2), sqrt(1 - u1) * cos(6.2831853 * u2), sqrt(u1) * sin(6.2831853 * u3), sqrt(u1) * cos(6.2831853 * u3));
    float x = q.x, y = q.y, z = q.z, w = q.w;
    return float3x3(1 - 2 * (y * y + z * z), 2 * (x * y - w * z), 2 * (x * z + w * y),
                    2 * (x * y + w * z), 1 - 2 * (x * x + z * z), 2 * (y * z - w * x),
                    2 * (x * z - w * y), 2 * (y * z + w * x), 1 - 2 * (x * x + y * y));
}

groupshared float4 gsR[32], gsG[32], gsB[32];
groupshared float2 gsLum[32];             // sum and sum of squares of the rays' luminance (how noisy this update is)

[numthreads(32, 1, 1)]
void ProbeTrace(uint3 group : SV_GroupID, uint thread : SV_GroupIndex)
{
    int n = _GridSize.w;
    uint slices = (uint)_ProbeInfo.x;
    uint perRow = (uint)n / slices;
    // Group g updates one probe out of each run of 'slices' along x; the choice moves on every frame and differs per row.
    uint g = group.x;
    uint row = g / perRow;                               // over z and slabs
    uint x = (g % perRow) * slices + ((uint)_ProbeInfo.z + row) % slices;
    uint z = row % (uint)n, slab = row / (uint)n;
    uint storey = slab >> 1, layer = slab & 1u;
    int2 cell = _CellMin.xy + int2(x, z);
    uint o = Occ(cell, storey);
    uint2 texel = ProbeTexel(cell, slab);
    uint keyIndex = (slab * (uint)n + (texel.y - slab * n)) * (uint)n + texel.x;
    float4 r = 0, gg = 0, b = 0;
    float2 lumStats = 0;
    bool loaded = LG_Loaded(o);
    if (loaded)
    {
        float2 h = LG_ProbeHeights(o, storey * _GridMisc.x);
        float3 P = float3((cell.x + 0.5) * LG_CELL, layer == 0 ? h.x : h.y, (cell.y + 0.5) * LG_CELL);
        float3x3 spin = RandomRotation(keyIndex * 9781u + (uint)_ProbeParams.x * 6271u);
        uint rays = (uint)_ProbeInfo.y, count = rays * 32u;
        for (uint k = 0; k < rays; k++)
        {
            float3 d = mul(spin, SphericalFibonacci(thread * rays + k, count));
            float3 L = TraceRadiance(P, d, storey);
            float4 basis = float4(0.282095, 0.488603 * d);
            r += L.r * basis; gg += L.g * basis; b += L.b * basis;
            float lum = dot(L, LUM);
            lumStats += float2(lum, lum * lum);
        }
    }
    gsR[thread] = r; gsG[thread] = gg; gsB[thread] = b; gsLum[thread] = lumStats;
    GroupMemoryBarrierWithGroupSync();
    [unroll] for (uint s = 16; s > 0; s >>= 1)
    {
        if (thread < s) { gsR[thread] += gsR[thread + s]; gsG[thread] += gsG[thread + s]; gsB[thread] += gsB[thread + s]; gsLum[thread] += gsLum[thread + s]; }
        GroupMemoryBarrierWithGroupSync();
    }
    if (thread != 0) return;
    if (!loaded)
    {
        _ProbeOutR[texel] = 0; _ProbeOutG[texel] = 0; _ProbeOutB[texel] = 0; _ProbeKey[keyIndex] = 0;
        return;
    }
    float scale = 12.566371 / (32.0 * _ProbeInfo.y);
    float4 nr = gsR[0] * scale, ng = gsG[0] * scale, nb = gsB[0] * scale;
    uint key = ProbeKey(cell, storey), stored = _ProbeKey[keyIndex];
    float hysteresis = _ProbeParams.y;
    uint still = 0;                                      // updates without a real change, so far
    if (!ProbeKeyIs(stored, key)) hysteresis = 0;
    else
    {
        // The longer nothing has changed, the longer the window the rays average over (up to _ProbeParams2.y): each update
        // traces 64 new rays, and in a dark room lit through a doorway the few that find light made the bounce shimmer.
        still = stored >> 24;
        hysteresis = max(hysteresis, min(still / (still + 1.0), _ProbeParams2.y));
        float before = dot(float3(_ProbePrevR[texel].x, _ProbePrevG[texel].x, _ProbePrevB[texel].x), LUM);
        float now = dot(float3(nr.x, ng.x, nb.x), LUM);
        float real;
        if (_ProbeParams2.x > 0.5)
        {
            // A real change (a light switched, a door opened) blends in fast; the noise of a few rays finding light does
            // not. What the rays' own spread explains is noise: the standard error of this update's L00.
            float count = 32.0 * _ProbeInfo.y;
            float mean = gsLum[0].x / count;
            float variance = max(gsLum[0].y / count - mean * mean, 0);
            float standardError = 12.566371 * 0.282095 * sqrt(variance / count);
            float change = abs(now - before);
            real = smoothstep(3.0, 6.0, change / max(standardError + 0.05 * before, 1e-5));
            hysteresis *= 1 - real * 0.7;
        }
        else
        {
            float change = abs(now - before) / max(max(now, before), 1e-3);
            real = smoothstep(0.25, 0.8, change);
            hysteresis *= 1 - real * 0.6;
        }
        if (real > 0.5) still = 0;                       // it changed: settle again from the start
    }
    _ProbeOutR[texel] = lerp(nr, _ProbePrevR[texel], hysteresis);
    _ProbeOutG[texel] = lerp(ng, _ProbePrevG[texel], hysteresis);
    _ProbeOutB[texel] = lerp(nb, _ProbePrevB[texel], hysteresis);
    _ProbeKey[keyIndex] = key | (min(still + 1u, 255u) << 24);
}

// Smooths the probes the shaders read: each probe with its four neighbours of the same height across open floor and
// openings (never across a wall, never from an unloaded cell). Takes the edge off the noise of 64 rays in dark places,
// where few rays find any light. The traced history itself stays unsmoothed (no blur building up over time).
#pragma kernel ProbeFilter
[numthreads(8, 8, 1)]
void ProbeFilter(uint3 id : SV_DispatchThreadID)
{
    int n = _GridSize.w;
    if ((int)id.x >= n || (int)id.y >= n || id.z > 3) return;
    uint slab = id.z, storey = slab >> 1;
    int2 cell = _CellMin.xy + (int2)id.xy;
    uint2 texel = ProbeTexel(cell, slab);
    uint o = Occ(cell, storey);
    float4 r = _ProbeInR[texel] * 2, g = _ProbeInG[texel] * 2, b = _ProbeInB[texel] * 2;
    float weight = 2;
    if (LG_Loaded(o))
    {
        [unroll] for (int side = 0; side < 4; side++)
        {
            int2 offset = side == 0 ? int2(-1, 0) : side == 1 ? int2(1, 0) : side == 2 ? int2(0, -1) : int2(0, 1);
            uint other = Occ(cell + offset, storey);
            uint owner = side == 0 || side == 2 ? o : other;
            uint kind = side < 2 ? LG_WestKind(owner) : LG_SouthKind(owner);
            // A broken wall that is mostly open lets the probes on its two sides share.
            bool open = false;
            [branch] if (kind == LG_EDGE_WALL && LG_Holed(owner, side < 2)) open = LG_HoleShare(side == 0 || side == 2 ? cell : cell + offset, side < 2, storey) > 0.5;
            if ((kind == LG_EDGE_WALL && !open) || !LG_Loaded(other)) continue;
            uint2 t = ProbeTexel(cell + offset, slab);
            r += _ProbeInR[t]; g += _ProbeInG[t]; b += _ProbeInB[t]; weight += 1;
        }
    }
    _ProbeSmoothR[texel] = r / weight; _ProbeSmoothG[texel] = g / weight; _ProbeSmoothB[texel] = b / weight;
}
