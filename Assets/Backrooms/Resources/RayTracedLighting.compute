// Ray-traced light for the player's camera (RayTracedLighting.cs), worked out after the depth prepass and before the opaque
// pass, with hardware ray queries (inline ray tracing, DirectX 12) against the scene round the camera.
//
// Shadows (2026-11-02): stochastic direct-light shadows for every fixture, as Unreal's MegaLights does it (Epic, SIGGRAPH
// 2025): each pixel picks a few of the fixtures that light it, in proportion to how much each gives (its light at the
// point, its distance and shape, the surface turned toward it, and the walls between: the light grid's own line test), and
// traces one ray to a random point on that fixture's panel. The forward pass keeps lighting every fixture exactly (walls
// already exact there) and multiplies their sum by what the rays found: the ratio estimator (Heitz, Hill & McGuire,
// "Combining Analytic Direct Illumination and Stochastic Shadows", 2018), which is exact for a single light and the
// light-weighted mean visibility for many. The scene holds only what casts shadows (furniture, props, doors, people, the
// player's body; walls, floors and ceilings are the light grid's), so a chair leg shadows every panel round it, far and
// near, with the true penumbra of a panel's area: sharp where it touches the floor, wider away from it.
// Blended over frames (reprojected, kept within the mean and spread of what this frame's neighbours found, so a moving
// shadow does not smear: FidelityFX's shadow denoiser) and filtered edge-aware in two passes.
//
// Occlusion: one short ray a pixel into the hemisphere (cosine-weighted, 1 m) against the same casters: what hides the
// sky of a point under a desk or beside a cabinet, on screen or not. ScreenLighting takes the smaller of it and its own
// screen-space visibility (so nothing is counted twice), and the lit shaders scale the probes' bounce by it.
//
// Reflections (run from ScreenLighting's pass, in place of its screen-space march, at its half resolution): one GGX ray a
// pixel against everything that is drawn (Lumen's hybrid way: the hit takes the last frame's light where it was on screen
// and seen, else a light worked out at the hit from the light grid: every fixture near it past the walls, and the grid's
// bounce; the hit's own normal from two neighbouring rays). A hit on a glowing panel, or a miss, is left to the room's
// reflection probe. So a chair, a pillar or a doorway behind the camera shows in a glossy floor, and probe light no
// longer shows where something stands in the way.
#pragma kernel Trace
#pragma kernel Temporal
#pragma kernel Blur1
#pragma kernel Blur
#pragma kernel Reflect
#pragma require inlineraytracing

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Assets/Backrooms/Shaders/LightGridSample.hlsl"

RaytracingAccelerationStructure _RTScene;
Texture2D<float> _CameraDepthTexture;
Texture2D<float4> _CameraNormalsTexture;
SamplerState sl_linear_clamp_sampler;

RWTexture2D<float4> _Pos;            // xyz world position, w linear depth (0: nothing there)
Texture2D<float4> _PosR, _PrevPos;
RWTexture2D<float4> _Trace;          // x the shadow rays' visibility, y 1 where fixtures light the point, z the occlusion ray's, w 1 where traced
Texture2D<float4> _TraceR;
RWTexture2D<float4> _Hist;           // x shadow over frames, y frames, z occlusion over frames
Texture2D<float4> _HistR;
RWTexture2D<float2> _Out;            // x the shadow the lit shader multiplies its fixtures' light by, y the occlusion

float4x4 _InvVP, _PrevVP;
float4 _CamPos;                      // xyz camera, w frame index
float4 _CamFwd;                      // xyz forward
float4 _PrevCam;                     // w 1 if the history is valid
float4 _Size;                        // xy size, zw 1 / size
float4 _ShadowParams;                // x rays a pixel (1-4; 0 = no shadows), y fade start (m), z fade end (m), w most frames blended
float4 _OccParams;                   // x on, y radius (m), z strength
float _FlipY, _ReversedZ;

#define MAX_TILE_LIGHTS 128u         // a backstop: a tile never lists more (LightGrid bins far fewer)
#define RT_CASTERS 1u                // instance masks (RayTracedLighting.cs)
#define RT_VISIBLE 2u

float Luma(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }
float IGN(float2 p) { return frac(52.9829189 * frac(dot(p, float2(0.06711056, 0.00583715)))); }
uint RTHash(uint x) { x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16; return x; }
float RTRand(uint seed) { return (RTHash(seed) >> 8) * (1.0 / 16777216.0); }

float3 WorldAt(float2 uv, float device)
{
    float4 c = float4(uv.x * 2.0 - 1.0, (uv.y * 2.0 - 1.0) * _FlipY, device, 1.0);
    float4 w = mul(_InvVP, c);
    return w.xyz / w.w;
}

bool Project(float4x4 m, float3 p, out float2 uv)
{
    float4 c = mul(m, float4(p, 1.0));
    uv = 0;
    if (c.w <= 1e-4) return false;
    float2 n = c.xy / c.w;
    uv = float2(n.x * 0.5 + 0.5, n.y * _FlipY * 0.5 + 0.5);
    return all(uv > 0.0) && all(uv < 1.0);
}

bool Sky(float device) { return _ReversedZ > 0.5 ? device <= 1e-7 : device >= 1.0 - 1e-7; }

void Basis(float3 N, out float3 T, out float3 B)
{
    T = normalize(abs(N.y) < 0.99 ? cross(float3(0, 1, 0), N) : cross(float3(1, 0, 0), N));
    B = cross(N, T);
}

bool AnyHit(float3 origin, float3 dir, float tMax, uint mask)
{
    RayDesc ray;
    ray.Origin = origin; ray.Direction = dir; ray.TMin = 0.0; ray.TMax = tMax;
    RayQuery<RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES> q;
    q.TraceRayInline(_RTScene, RAY_FLAG_NONE, mask, ray);
    q.Proceed();
    return q.CommittedStatus() == COMMITTED_TRIANGLE_HIT;
}

float ClosestHit(float3 origin, float3 dir, float tMax, uint mask)
{
    RayDesc ray;
    ray.Origin = origin; ray.Direction = dir; ray.TMin = 0.0; ray.TMax = tMax;
    RayQuery<RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES> q;
    q.TraceRayInline(_RTScene, RAY_FLAG_NONE, mask, ray);
    q.Proceed();
    return q.CommittedStatus() == COMMITTED_TRIANGLE_HIT ? q.CommittedRayT() : -1.0;
}

// The surface's own normal from the depth (the side nearer in depth each way, so an edge takes the surface it belongs to).
float3 GeometricNormal(int2 px, float3 P, float3 Ns)
{
    int2 full = (int2)_Size.xy - 1;
    int2 bx0 = clamp(px - int2(1, 0), 0, full), bx1 = clamp(px + int2(1, 0), 0, full);
    int2 by0 = clamp(px - int2(0, 1), 0, full), by1 = clamp(px + int2(0, 1), 0, full);
    float3 X0 = WorldAt((bx0 + 0.5) * _Size.zw, _CameraDepthTexture[bx0]), X1 = WorldAt((bx1 + 0.5) * _Size.zw, _CameraDepthTexture[bx1]);
    float3 Y0 = WorldAt((by0 + 0.5) * _Size.zw, _CameraDepthTexture[by0]), Y1 = WorldAt((by1 + 0.5) * _Size.zw, _CameraDepthTexture[by1]);
    float3 dx = abs(dot(X1 - P, _CamFwd.xyz)) < abs(dot(P - X0, _CamFwd.xyz)) ? X1 - P : P - X0;
    float3 dy = abs(dot(Y1 - P, _CamFwd.xyz)) < abs(dot(P - Y0, _CamFwd.xyz)) ? Y1 - P : P - Y0;
    float3 g = cross(dx, dy);
    float gl = length(g);
    g = gl > 1e-8 ? g / gl : Ns;
    if (dot(g, _CamPos.xyz - P) < 0.0) g = -g;
    if (dot(g, Ns) < 0.2) g = Ns;                       // a bad reconstruction (a silhouette): the shading normal
    return g;
}

// How much of a fixture's light reaches P directly, before anything but walls is in the way: the share the forward pass
// lights per pixel (its real light's share, and its grid share near it), its distance and shape, the surface turned toward
// it (a little past the horizon: a panel is not a point), and the light grid's line test through walls and headers.
float LightWeight(LGridLight f, float3 P, float3 Ng, out float distanceToLight)
{
    float3 delta = f.pos - P;
    float d2 = dot(delta, delta);
    distanceToLight = sqrt(d2);
    if (d2 >= f.range * f.range) return 0;
    float3 energy = max(f.colorAll - f.color, 0) + f.color * LGrid_NearWeight(distanceToLight);
    float e = Luma(energy);
    if (e <= 1e-6) return 0;
    float3 L = delta / max(distanceToLight, 1e-4);
    float atten = LGrid_DistAtten(max(d2, 0.01), f.range);
    if (dot(f.dir, f.dir) > 0.5) atten *= LGrid_Profile(dot(f.dir, -L), f.cosOuter, f.cosInner, f.padding.y);
    float facing = saturate((dot(Ng, L) + 0.15) / 1.15);
    float w = e * atten * facing;
    if (w <= 1e-7) return 0;
    return w * LGrid_LightVisible(P, Ng, f.pos);
}

// A point on the fixture's glowing area: the panel's rectangle (world x and z), or a small ball for a lamp's bulb.
float3 EmitterPoint(LGridLight f, float2 u)
{
    if (dot(f.halfSize, f.halfSize) > 1e-6)
        return f.pos + float3((u.x * 2.0 - 1.0) * f.halfSize.x, 0.0, (u.y * 2.0 - 1.0) * f.halfSize.y);
    float z = u.x * 2.0 - 1.0, r = sqrt(saturate(1.0 - z * z)), ph = 2.0 * PI * u.y;
    return f.pos + 0.1 * float3(r * cos(ph), z, r * sin(ph));
}


// ---------------------------------------------------------------- trace (shadows and occlusion)
#define MAX_RAYS 4

[numthreads(8, 8, 1)]
void Trace(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Size.xy)) return;
    float device = _CameraDepthTexture[id.xy];
    float4 n = _CameraNormalsTexture[id.xy];
    float nl = length(n.xyz);
    if (Sky(device) || nl < 0.1) { _Pos[id.xy] = 0; _Trace[id.xy] = float4(1, 0, 1, 0); return; }
    float2 uv = (id.xy + 0.5) * _Size.zw;
    float3 P = WorldAt(uv, device);
    float depth = dot(P - _CamPos.xyz, _CamFwd.xyz);
    _Pos[id.xy] = float4(P, max(depth, 1e-4));
    if (n.w < -0.5 || depth > _ShadowParams.z) { _Trace[id.xy] = float4(1, 0, 1, 0); return; }   // an emitter, or too far
    float3 Ns = n.xyz / nl;
    float3 Ng = GeometricNormal((int2)id.xy, P, Ns);
    uint frame = (uint)_CamPos.w;
    float3 O = P + Ng * (0.012 + 0.0015 * depth);
    float4 result = float4(1, 0, 1, 0);

    // Occlusion: one cosine-weighted ray within the radius (blue noise over frames).
    if (_OccParams.x > 0.5)
    {
        float2 u = frac(float2(IGN(id.xy + 11.3 + 5.588238 * (frame % 64u)), IGN(id.yx + 31.7 + 7.13 * (frame % 64u))));
        float3 T, B;
        Basis(Ng, T, B);
        float r = sqrt(u.x), ph = 2.0 * PI * u.y;
        float3 dir = normalize(T * (r * cos(ph)) + B * (r * sin(ph)) + Ng * sqrt(max(1.0 - u.x, 0.0)));
        float t = ClosestHit(O, dir, _OccParams.y, RT_CASTERS);
        float occluded = t >= 0.0 ? 1.0 - smoothstep(0.08 * _OccParams.y, _OccParams.y, t) : 0.0;
        result.zw = float2(1.0 - occluded * _OccParams.z, 1.0);
    }

    // Shadows. Weighted reservoir sampling: one pass over the fixtures of this point's tile, each ray keeping a fixture
    // with probability its weight / the weights so far, so every ray ends with a fixture picked in proportion to its light.
    int rays = clamp((int)_ShadowParams.x, 0, MAX_RAYS);
    if (rays > 0 && _LGridParams.x > 0.5 && all(P.xz >= _LGridWindow.xy) && all(P.xz <= _LGridWindow.zw))
    {
        uint seed = RTHash(id.x * 1973u + id.y * 9277u + frame * 26699u);
        uint2 tile = LGrid_TileRange(P);
        float total = 0;
        uint pick[MAX_RAYS] = { 0u, 0u, 0u, 0u };
        [loop] for (uint i = 0; i < min(tile.y, MAX_TILE_LIGHTS); i++)
        {
            uint fid = _LGridTileLights[tile.x + i];
            LGridLight f = _LGridLights[fid];
            float dist;
            float w = LightWeight(f, P, Ng, dist);
            if (w <= 0) continue;
            total += w;
            float keep = w / total;
            [unroll] for (int r = 0; r < MAX_RAYS; r++)
                if (r < rays && RTRand(seed + i * 7919u + r * 104729u) < keep) pick[r] = fid;
        }
        if (total > 1e-7)
        {
            // One ray to a random point on each picked fixture's panel (blue-noise offsets over frames).
            float vis = 0;
            [loop] for (int r = 0; r < rays; r++)
            {
                LGridLight f = _LGridLights[pick[r]];
                float2 u = frac(float2(IGN(id.xy + 5.588238 * (frame % 64u) + r * 17.0), IGN(id.yx + 3.7 + 7.13 * (frame % 64u) + r * 29.0))
                                + float2(0.7548777, 0.5698403) * r);
                float3 toT = EmitterPoint(f, u) - O;
                float len = length(toT);
                // The fitting's own body near the light is not a blocker (as the shadow maps' blocker search had it); a
                // lamp's shade shapes its light in the lamp's own model.
                float tMax = max(len - (dot(f.halfSize, f.halfSize) > 1e-6 ? 0.08 : 0.3), 0.0);
                vis += AnyHit(O, toT / max(len, 1e-4), tMax, RT_CASTERS) ? 0.0 : 1.0;
            }
            result.xy = float2(vis / rays, 1);
        }
    }
    _Trace[id.xy] = result;
}

// ---------------------------------------------------------------- blending over frames
[numthreads(8, 8, 1)]
void Temporal(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Size.xy)) return;
    float4 pp = _PosR[id.xy];
    float4 t = _TraceR[id.xy];
    if (pp.w <= 0.0) { _Hist[id.xy] = float4(1, 0, 1, 0); return; }
    // What this frame's rays found round the point: the history is kept within it, so where a shadow moves (a door, a
    // prop carried, the player) the old shadow does not linger.
    // (2026-11-02, the owner: the shadows ghosted and had a texture to them when moving side to side.) It was kept within
    // the lowest and highest of the 3 x 3 neighbours, but with one ray a pixel a soft shadow's neighbours are both lit and
    // shaded, so that range was 0..1 and held nothing back: the player's own soft shadow trailed behind them. Now, as AMD's
    // FidelityFX shadow denoiser does: within the mean of the 7 x 7 neighbours on the same surface, give or take half
    // their spread (a fully lit or shaded neighbourhood pins the history to it; a penumbra keeps it near its true value).
    // Where the 3 x 3 is all one value the history may also reach that value, so a sharp shadow's edge is not softened.
    float2 lo3 = t.xz, hi3 = t.xz;
    [unroll] for (int y = -1; y <= 1; y++)
    [unroll] for (int x = -1; x <= 1; x++)
    {
        float4 c = _TraceR[clamp((int2)id.xy + int2(x, y), 0, (int2)_Size.xy - 1)];
        if (c.y > 0.5) { lo3.x = min(lo3.x, c.x); hi3.x = max(hi3.x, c.x); }
        if (c.w > 0.5) { lo3.y = min(lo3.y, c.z); hi3.y = max(hi3.y, c.z); }
    }
    float2 s1 = 0, s2 = 0, sn = 0;
    float tolD = 0.04 * pp.w + 0.02;
    [loop] for (int my = -3; my <= 3; my++)
    [unroll] for (int mx = -3; mx <= 3; mx++)
    {
        int2 q = clamp((int2)id.xy + int2(mx, my), 0, (int2)_Size.xy - 1);
        float4 qp = _PosR[q];
        if (qp.w <= 0.0 || abs(qp.w - pp.w) > tolD) continue;
        float4 c = _TraceR[q];
        if (c.y > 0.5) { s1.x += c.x; s2.x += c.x * c.x; sn.x += 1.0; }
        if (c.w > 0.5) { s1.y += c.z; s2.y += c.z * c.z; sn.y += 1.0; }
    }
    float2 mean = s1 / max(sn, 1.0);
    float2 sd = sqrt(max(s2 / max(sn, 1.0) - mean * mean, 0.0));
    float2 lo = mean - 0.5 * sd - 0.02, hi = mean + 0.5 * sd + 0.02;
    if (hi3.x - lo3.x < 0.01) { lo.x = min(lo.x, lo3.x); hi.x = max(hi.x, hi3.x); }
    if (hi3.y - lo3.y < 0.01) { lo.y = min(lo.y, lo3.y); hi.y = max(hi.y, hi3.y); }    // The last frame's values at this point: bilinear among the four texels that saw this same surface.
    float3 hv = 0;
    float hw = 0;
    float2 puv;
    if (_PrevCam.w > 0.5 && Project(_PrevVP, pp.xyz, puv))
    {
        float2 h = puv * _Size.xy - 0.5;
        int2 b = (int2)floor(h);
        float2 fr = h - b;
        float tol = 0.03 + 0.015 * pp.w;
        [unroll] for (int k = 0; k < 4; k++)
        {
            int2 o = int2(k & 1, k >> 1);
            int2 q = clamp(b + o, 0, (int2)_Size.xy - 1);
            float4 was = _PrevPos[q];
            if (was.w <= 0.0 || distance(was.xyz, pp.xyz) > tol) continue;
            float4 hh = _HistR[q];
            if (hh.y < 0.5 || !all(isfinite(hh))) continue;
            float bw = (o.x ? fr.x : 1.0 - fr.x) * (o.y ? fr.y : 1.0 - fr.y) + 1e-4;
            hv += bw * hh.xyz; hw += bw;
        }
    }
    float4 outH = float4(t.y > 0.5 ? t.x : 1.0, 1.0, t.w > 0.5 ? t.z : 1.0, 0.0);
    if (hw > 1e-3)
    {
        hv /= hw;
        float2 kept = float2(clamp(hv.x, lo.x, hi.x), clamp(hv.z, lo.y, hi.y));
        // History the clamp had to pull far is stale (a shadow moved off it): its count starts again, so this frame's rays
        // take over within a few frames instead of the clamped value fading out over twelve (a grey trail behind the feet).
        float2 pulled = abs(float2(hv.x, hv.z) - kept) * float2(t.y > 0.5 ? 1.0 : 0.0, t.w > 0.5 ? 1.0 : 0.0);
        float stale = saturate((max(pulled.x, pulled.y) - 0.04) * 6.0);
        float count = min(lerp(floor(hv.y + 0.5), 0.0, stale) + 1.0, _ShadowParams.w);
        float k = 1.0 / count;
        outH.x = t.y > 0.5 ? lerp(kept.x, t.x, k) : 1.0;
        outH.z = t.w > 0.5 ? lerp(kept.y, t.z, k) : 1.0;
        outH.y = count;
    }
    _Hist[id.xy] = saturate(float4(outH.x, 0, outH.z, 0)) + float4(0, outH.y, 0, 0);
}

// ---------------------------------------------------------------- edge-aware filter
// Two passes of a 5 x 5 (an a-trous filter, as SVGF and FidelityFX's shadow denoiser): every pixel, then every other
// pixel (2026-11-02; one pass left a grain in the penumbras that slid over the floor as the view moved). Wider while the
// history is short. The first pass writes into the trace texture (free once blended), the second the output.
RWTexture2D<float4> _Filt;

float2 FilterAt(uint2 id, float4 pp, float4 c0, int stride)
{
    float3 N = normalize(_CameraNormalsTexture[id].xyz + 1e-5);
    float2 s = 0, lo = 1, hi = 0;
    float ws = 0;
    [loop] for (int y = -2; y <= 2; y++)
    [loop] for (int x = -2; x <= 2; x++)
    {
        int2 q = clamp((int2)id.xy + int2(x, y) * stride, 0, (int2)_Size.xy - 1);
        float4 qp = _PosR[q];
        float4 h = _HistR[q];
        if (qp.w <= 0.0 || h.y < 0.5) continue;
        float3 qn = _CameraNormalsTexture[q].xyz;
        float plane = abs(dot(qp.xyz - pp.xyz, N));
        float w = exp(-plane / (0.02 + 0.006 * pp.w)) * pow(saturate(dot(normalize(qn + 1e-5), N)), 8.0);
        w *= exp(-(x * x + y * y) * 0.25);
        s += w * h.xz; ws += w;
        lo = min(lo, h.xz); hi = max(hi, h.xz);
    }
    float2 v = ws > 1e-5 ? s / ws : c0.xz;
    // A fully lit or fully shaded neighbourhood stays exactly so (no grey creeping in from the filter's edge).
    if (hi.x - lo.x < 0.02) v.x = c0.x;
    if (hi.y - lo.y < 0.02) v.y = c0.z;
    return saturate(v);
}

[numthreads(8, 8, 1)]
void Blur1(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Size.xy)) return;
    float4 pp = _PosR[id.xy];
    float4 c0 = _HistR[id.xy];
    if (pp.w <= 0.0 || c0.y < 0.5) { _Filt[id.xy] = c0; return; }
    float2 v = FilterAt(id.xy, pp, c0, c0.y < 4.0 ? 2 : 1);
    _Filt[id.xy] = float4(v.x, c0.y, v.y, 0);
}

[numthreads(8, 8, 1)]
void Blur(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_Size.xy)) return;
    float4 pp = _PosR[id.xy];
    float4 c0 = _HistR[id.xy];
    if (pp.w <= 0.0 || c0.y < 0.5) { _Out[id.xy] = 1; return; }
    float2 v = FilterAt(id.xy, pp, c0, c0.y < 4.0 ? 4 : 2);
    float fade = smoothstep(_ShadowParams.y, _ShadowParams.z, pp.w);
    _Out[id.xy] = lerp(v, 1.0, fade);
}

// ---------------------------------------------------------------- reflections (ScreenLighting's half resolution)
Texture2D<float4> _HalfPosR, _HalfNormalR, _HalfGeoR, _HalfPrevPos;
Texture2D<float4> _ColorHist;        // the last frame's lit picture (half size, mips)
RWTexture2D<float4> _RefTrace;       // rgb reflected light, a how much of the reflection was found
float4 _HalfSize;                    // xy size, zw 1 / size
float4 _RefParams;                   // x on, y max distance, z pixels per metre at 1 m (half size), w smoothest skipped below
float4 _RefParams2;                  // x the brightest light taken, y albedo guess for hits worked out from the grid, z history valid

float3 SampleGGXVNDF(float3 Ve, float alpha, float2 u)
{
    float3 Vh = normalize(float3(alpha * Ve.x, alpha * Ve.y, Ve.z));
    float lensq = Vh.x * Vh.x + Vh.y * Vh.y;
    float3 T1 = lensq > 0 ? float3(-Vh.y, Vh.x, 0) * rsqrt(lensq) : float3(1, 0, 0);
    float3 T2 = cross(Vh, T1);
    float r = sqrt(u.x), ph = 2.0 * PI * u.y;
    float t1 = r * cos(ph), t2 = r * sin(ph);
    float sv = 0.5 * (1.0 + Vh.z);
    t2 = (1.0 - sv) * sqrt(1.0 - t1 * t1) + sv * t2;
    float3 Nh = t1 * T1 + t2 * T2 + sqrt(max(0.0, 1.0 - t1 * t1 - t2 * t2)) * Vh;
    return normalize(float3(alpha * Nh.x, alpha * Nh.y, max(0.0, Nh.z)));
}

// The light at a point from the last frame's picture, where it was on screen and its own surface was seen there.
bool HistoryLight(float3 p, float depth, float mip, out float3 light)
{
    light = 0;
    if (_RefParams2.z < 0.5) return false;
    float2 uv;
    if (!Project(_PrevVP, p, uv)) return false;
    float4 was = _HalfPrevPos[min((int2)(uv * _HalfSize.xy), (int2)_HalfSize.xy - 1)];
    if (was.w <= 0.0 || distance(was.xyz, p) > 0.06 + 0.025 * depth) return false;
    light = _ColorHist.SampleLevel(sl_linear_clamp_sampler, uv, mip).rgb;
    float l = Luma(light);
    if (!(l >= 0.0)) { light = 0; return false; }
    if (l > _RefParams2.x) light *= _RefParams2.x / l;
    return true;
}

// The light leaving a point off screen, worked out from the light grid: every fixture of its tile (distance, shape, the
// walls between) and the grid's own light there (its far share and bounce), on a surface of an average colour. Returns
// false on a glowing panel (the probe has those; their own highlight is the direct light's).
bool GridRadiance(float3 H, float3 N, out float3 radiance)
{
    radiance = 0;
    if (_LGridParams.x < 0.5 || any(H.xz < _LGridWindow.xy) || any(H.xz > _LGridWindow.zw)) return false;
    uint2 tile = LGrid_TileRange(H);
    float3 E = 0;
    [loop] for (uint i = 0; i < min(tile.y, MAX_TILE_LIGHTS); i++)
    {
        LGridLight f = _LGridLights[_LGridTileLights[tile.x + i]];
        float3 delta = f.pos - H;
        if (abs(delta.y) < 0.12 && all(abs(delta.xz) < f.halfSize + 0.06)) return false;     // on the panel itself
        float d2 = dot(delta, delta);
        if (d2 >= f.range * f.range) continue;
        float3 energy = max(f.colorAll - f.color, 0) + f.color * LGrid_NearWeight(sqrt(d2));
        float3 L = delta * rsqrt(max(d2, 1e-6));
        float ndl = saturate(dot(N, L));
        if (ndl <= 0 || Luma(energy) <= 1e-6) continue;
        float atten = LGrid_DistAtten(max(d2, 0.01), f.range);
        if (dot(f.dir, f.dir) > 0.5) atten *= LGrid_Profile(dot(f.dir, -L), f.cosOuter, f.cosInner, f.padding.y);
        if (atten * ndl <= 1e-6) continue;
        E += energy * (atten * ndl * LGrid_LightVisible(H, N, f.pos));
    }
    E = E * _LGridParams.y + BackroomsLightGrid(H, N);
    radiance = E * _RefParams2.y * float3(1.0, 0.93, 0.78);
    return all(isfinite(radiance));
}

[numthreads(8, 8, 1)]
void Reflect(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_HalfSize.xy)) return;
    float4 pp = _HalfPosR[id.xy];
    float4 nn = _HalfNormalR[id.xy];
    if (_RefParams.x < 0.5 || pp.w <= 0.0 || nn.w < _RefParams.w) { _RefTrace[id.xy] = 0; return; }
    float3 P = pp.xyz, N = nn.xyz, Ng = _HalfGeoR[id.xy].xyz;
    float3 V = normalize(_CamPos.xyz - P);
    float rough = 1.0 - saturate(nn.w), alpha = max(rough * rough, 0.002);
    float frame = fmod(_CamPos.w, 64.0);
    float2 u = float2(IGN(id.xy + 7.13 * frame), IGN(id.xy.yx + 3.7 + 13.1 * frame));
    // The lobe a little narrower than the surface's (the mip at the hit blurs the rest; less noise).
    float3 T, B;
    Basis(N, T, B);
    float3 Ve = float3(dot(V, T), dot(V, B), dot(V, N));
    float3 He = SampleGGXVNDF(Ve, alpha * 0.6, u);
    float3 H = T * He.x + B * He.y + N * He.z;
    float3 R = reflect(-V, H);
    if (dot(R, Ng) < 0.02) R = reflect(-V, N);
    if (dot(R, Ng) < 0.0) { _RefTrace[id.xy] = 0; return; }
    float3 O = P + Ng * (0.015 + 0.002 * pp.w);
    float maxD = _RefParams.y;
    float t = ClosestHit(O, R, maxD, RT_VISIBLE);
    if (t < 0.0) { _RefTrace[id.xy] = 0; return; }                // nothing within reach: the probe
    float3 X = O + R * t;
    float conf = (1.0 - smoothstep(0.75, 1.0, t / maxD)) * saturate((nn.w - _RefParams.w) / 0.12);
    // On screen last frame: its own light from the picture, from a mip as wide as the lobe's cone there.
    float hitDepth = max(dot(X - _CamPos.xyz, _CamFwd.xyz), 0.05);
    float px = t * alpha * 0.7 * _RefParams.z / hitDepth;
    float3 L;
    if (HistoryLight(X, hitDepth, clamp(log2(max(px, 1.0)), 0.0, 5.0), L)) { _RefTrace[id.xy] = float4(L, conf); return; }
    // Off screen: the hit's own normal from two neighbouring rays (a plane through the three hits), then its light from
    // the grid. Where the neighbours land on something else, the normal faces back along the ray.
    float3 Nh = -R;
    float eps = 0.004 + 0.002 * t;
    float3 TR, BR;
    Basis(R, TR, BR);
    float t1 = ClosestHit(O, normalize(R + TR * eps), maxD, RT_VISIBLE);
    float t2 = ClosestHit(O, normalize(R + BR * eps), maxD, RT_VISIBLE);
    if (t1 > 0.0 && t2 > 0.0 && abs(t1 - t) < 0.2 * t + 0.05 && abs(t2 - t) < 0.2 * t + 0.05)
    {
        float3 X1 = O + normalize(R + TR * eps) * t1, X2 = O + normalize(R + BR * eps) * t2;
        float3 c = cross(X1 - X, X2 - X);
        if (dot(c, c) > 1e-14) { Nh = normalize(c); if (dot(Nh, R) > 0.0) Nh = -Nh; }
    }
    float3 Lg;
    if (!GridRadiance(X + Nh * 0.02, Nh, Lg)) { _RefTrace[id.xy] = 0; return; }
    float l = Luma(Lg);
    if (l > _RefParams2.x) Lg *= _RefParams2.x / l;
    _RefTrace[id.xy] = float4(Lg, conf);
}
